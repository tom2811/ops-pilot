{
  "id": "opspilot-ticket-routing",
  "name": "OpsPilot ticket routing",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "opspilot/ticket-created",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "e7b57b2f-3f4c-4b1e-9aa7-6d8b6f2a1c01",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-620, 0],
      "webhookId": "9e2e1d7c-6a2a-4f2e-8d4f-7b5a4c3d2e10"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($json.body ?? $json).callbackBaseUrl }}/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-opspilot-run-token",
              "value": "={{ ($('Webhook').item.json.body ?? $('Webhook').item.json).token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ticketId: ($json.body ?? $json).event.payload.ticketId, recipientId: ($json.body ?? $json).event.payload.requesterId, channel: 'email', templateKey: 'ticket_created', variables: { number: ($json.body ?? $json).event.payload.number, subject: ($json.body ?? $json).event.payload.subject } }) }}",
        "options": {}
      },
      "id": "2a1b0c9d-7e6f-4a3b-8c2d-9e8f7a6b5c04",
      "name": "Record notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($('Webhook').item.json.body ?? $('Webhook').item.json).callbackBaseUrl }}/complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-opspilot-run-token",
              "value": "={{ ($('Webhook').item.json.body ?? $('Webhook').item.json).token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'completed' }) }}",
        "options": {}
      },
      "id": "8f7e6d5c-4b3a-2f1e-9d8c-7b6a5f4e3d05",
      "name": "Complete run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Record notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record notification": {
      "main": [
        [
          {
            "node": "Complete run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
